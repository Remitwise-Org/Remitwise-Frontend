datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String          @id @default(cuid())
  stellar_address String          @unique
  sessionVersion  Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  preferences     UserPreference?
}

model UserPreference {
  id                    String  @id @default(cuid())
  userId                String  @unique
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency              String  @default("USD")
  language              String  @default("en")
  notifications_enabled Boolean @default(true)
}

model TutorialProgress {
  id         String   @id @default(cuid())
  userId     String
  tutorialId String
  data       String   // JSON string containing chapters progress
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, tutorialId])
  @@index([userId])
  @@index([tutorialId])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  source      String    // e.g. "anchor", "stripe"
  eventType   String    // e.g. "deposit_completed"
  rawPayload  String    // raw JSON body
  status      String    @default("pending") // pending | processing | processed | failed | dlq
  retryCount  Int       @default(0)
  maxRetries  Int       @default(5)
  lastError   String?
  nextRetryAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime?

  @@index([status])
  @@index([source])
  @@index([nextRetryAt])
}

model RecurringRemittance {
  id               String    @id @default(cuid())
  userAddress      String
  recipientAddress String
  amountStroops    BigInt
  currency         String
  frequency        String    // weekly | biweekly | monthly
  nextRunAt        DateTime
  lastRunAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userAddress])
}


model AnchorFlow {
  id                  String   @id @default(cuid())
  type                String
  userAddress         String
  amount              String
  currency            String
  destination         String?
  anchorTransactionId String? @unique
  anchorUrl           String?
  status              String
  reconcileAttempts   Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model AuditEvent {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  event     String
  identity  String
  details   String
}

model IdempotencyRecord {
  key          String   @id
  requestHash  String
  responseBody String
  statusCode   Int
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

