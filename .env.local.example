# ============================================================
# Stellar Network Configuration
# ============================================================
# STELLAR_NETWORK: network name used by server-side config (testnet|mainnet).
#   Default: testnet. Required: no.
STELLAR_NETWORK=testnet
# STELLAR_NETWORK_PASSPHRASE: network passphrase for transaction signing.
#   Default: "Test SDF Network ; September 2015". Required: no.
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# STELLAR_HORIZON_URL: Horizon API base URL.
#   Default: https://horizon-testnet.stellar.org. Required: no.
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# HORIZON_URL: alternative name for the Horizon API base URL (used by some services).
#   Default: falls back to STELLAR_HORIZON_URL. Required: no.
# HORIZON_URL=https://horizon-testnet.stellar.org
# STELLAR_EXPLORER_TX_URL: block explorer prefix for transaction links.
#   Default: https://stellar.expert/explorer/public/tx/. Required: no.
STELLAR_EXPLORER_TX_URL=https://stellar.expert/explorer/public/tx/
# CUSTODIAL_MODE: set to "true" to enable server-side custodial signing.
#   Default: false. Required: no.
CUSTODIAL_MODE=false
# SERVER_SECRET_KEY: server Stellar secret key, used only when CUSTODIAL_MODE=true.
#   Default: empty. Required: only in custodial mode. Never commit a real key.
SERVER_SECRET_KEY=your_server_secret_key_here

NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ============================================================
# Soroban Contract Addresses (network-resolved)
# ============================================================
# Resolution order: CONTRACT_IDS_JSON, then <NAME>_CONTRACT_ID_<NETWORK>,
# then <NAME>_CONTRACT_ID. Required: yes for each contract you call.
# CONTRACT_IDS_JSON: optional JSON map of {"testnet":{...},"mainnet":{...}}.
#   Default: unset. Required: no.
# CONTRACT_IDS_JSON={"testnet":{"REMITTANCE_SPLIT_CONTRACT_ID":"your_testnet_contract_id_here"}}
REMITTANCE_SPLIT_CONTRACT_ID_TESTNET=your_testnet_contract_id_here
REMITTANCE_SPLIT_CONTRACT_ID_MAINNET=your_mainnet_contract_id_here
SAVINGS_GOALS_CONTRACT_ID_TESTNET=your_testnet_contract_id_here
SAVINGS_GOALS_CONTRACT_ID_MAINNET=your_mainnet_contract_id_here
BILL_PAYMENTS_CONTRACT_ID_TESTNET=your_testnet_contract_id_here
BILL_PAYMENTS_CONTRACT_ID_MAINNET=your_mainnet_contract_id_here
INSURANCE_CONTRACT_ID_TESTNET=your_testnet_contract_id_here
INSURANCE_CONTRACT_ID_MAINNET=your_mainnet_contract_id_here
# FAMILY_WALLET_CONTRACT_ID: family wallet contract ID (network-scoped variant also supported).
#   Default: unset. Required: only if family wallet features are used.
FAMILY_WALLET_CONTRACT_ID=your_family_wallet_contract_id_here
# HEALTH_INCLUDE_CONTRACT_IDS: comma-separated contract names to include in the health check.
#   Default: all resolvable contracts. Required: no.
# HEALTH_INCLUDE_CONTRACT_IDS=REMITTANCE_SPLIT,SAVINGS_GOALS

# ============================================================
# Session Configuration
# ============================================================
# SESSION_PASSWORD: iron-session encryption secret, minimum 32 characters.
#   Default: none. Required: yes. Generate with: openssl rand -base64 32
SESSION_PASSWORD=your-32-char-minimum-secret-here
# SESSION_MAX_AGE: session lifetime in seconds.
#   Default: 604800 (7 days). Required: no.
# SESSION_MAX_AGE=604800
# SESSION_REFRESH_ENABLED: "true" enables sliding-window session refresh.
#   Default: false. Required: no.
# SESSION_REFRESH_ENABLED=false

# ============================================================
# Anchor / Backend Variables (set in deployment environment)
# ============================================================
# For local dev without real Anchor credentials, run `npm run mock:anchor`
# and point this at it instead: ANCHOR_API_BASE_URL=http://localhost:4100
# ANCHOR_API_BASE_URL: anchor API base URL. Default: none. Required: yes for anchor features.
ANCHOR_API_BASE_URL=https://api.example.com/anchor
# ANCHOR_API_KEY: anchor API key. Default: none. Required: yes for anchor features.
ANCHOR_API_KEY=your_anchor_api_key_here
# ANCHOR_WEBHOOK_SECRET: shared secret for verifying anchor webhooks.
#   Default: none. Required: yes if anchor webhooks are enabled.
ANCHOR_WEBHOOK_SECRET=your_shared_anchor_secret_here
# ADMIN_SECRET: secret for admin endpoints. Default: none. Required: yes for admin routes.
ADMIN_SECRET=replace_with_rotatable_admin_secret

# ============================================================
# Webhook Processing
# ============================================================
# WEBHOOK_MAX_RETRIES: maximum delivery attempts per webhook event.
#   Default: from WEBHOOK_RETRY_CONFIG in lib/webhooks/processor. Required: no.
# WEBHOOK_MAX_RETRIES=5
# WEBHOOK_LEASE_TIMEOUT_MS: how long a worker lease on an event lasts before reclaim.
#   Default: set in lib/webhooks/processor. Required: no.
# WEBHOOK_LEASE_TIMEOUT_MS=60000

# ============================================================
# Caching / TTLs
# ============================================================
# QUOTE_TTL_SECONDS: lifetime of a cached quote, in seconds. Default: service default. Required: no.
# QUOTE_TTL_SECONDS=30
# DASHBOARD_TTL_SECONDS: lifetime of cached dashboard data, in seconds. Default: service default. Required: no.
# DASHBOARD_TTL_SECONDS=60

# ============================================================
# Frontend Configuration
# ============================================================
# NEXT_PUBLIC_APP_URL: public base URL of this app (used for auth issuer fallback).
#   Default: http://localhost:3000. Required: recommended in production.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_AUTH_ISSUER_URL: SEP-10 WEB_AUTH_ENDPOINT published in stellar.toml.
#   Default: ${NEXT_PUBLIC_APP_URL}/api/auth. Required: no.
# NEXT_PUBLIC_AUTH_ISSUER_URL=http://localhost:3000/api/auth
# STELLAR_WEB_AUTH_ENDPOINT: server-only fallback for NEXT_PUBLIC_AUTH_ISSUER_URL. Required: no.
# STELLAR_WEB_AUTH_ENDPOINT=http://localhost:3000/api/auth
NEXT_PUBLIC_TOAST_TIMEOUT=5000
NEXT_PUBLIC_SWAP_PAGE_ENABLED=false

# ============================================================
# Framework-provided variables (do NOT set manually)
# ============================================================
# NODE_ENV, NEXT_RUNTIME, and VERCEL_GIT_COMMIT_SHA are provided by
# Next.js / Vercel. They are not required and should not be set in this file.
